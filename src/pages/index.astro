        font-size: 0.88em;
      }

      .app-shell {
        width: 100%;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        padding-bottom: calc(var(--nav-height) + env(safe-area-inset-bottom) + 12px);
      }

      /* Compact Top Header */
