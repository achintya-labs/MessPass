        opacity: 0;
        pointer-events: none;
        z-index: 1;
        border: none;
        padding: 0;
        margin: 0;
      }

      .today-btn {
        height: 30px;
        padding: 0 9px;
        border-radius: 7px;
        border: 1px solid transparent;
        background: transparent;
        color: var(--text-muted);
        font-size: 0.76rem;
        font-weight: 600;
        cursor: pointer;
        flex-shrink: 0;
        transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
      }

      .today-btn:hover {
        color: var(--text);
        background: var(--surface-alt);
      }

      .today-btn.is-today {
        color: var(--accent-fg);
      }

      /* Quick Saved Dates Strip */
      .date-chips-bar {
        display: flex;
        align-items: center;
        gap: 6px;
        overflow-x: auto;
        padding: 2px 0;
        scrollbar-width: none;
      }

      .date-chips-bar::-webkit-scrollbar {
        display: none;
      }

      .date-chips-bar[hidden] {
        display: none;
      }

      .date-chip {
        flex-shrink: 0;
        height: 28px;
        padding: 0 10px;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text-muted);
        font-size: 0.74rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
      }

      .date-chip:hover {
        border-color: var(--primary);
        color: var(--text);
      }

      .date-chip.is-active {
        background: var(--accent-soft);
        border-color: var(--primary);
        color: var(--accent-fg);
      }

      /* Swipeable Pass Carousel (Mobile) */
      .passes-stage {
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-width: 0;
        width: 100%;
      }

      .pass-carousel {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        width: 100%;
        margin: 0;
      }

      .pass-carousel::-webkit-scrollbar {
        display: none;
      }

      .pass-slide {
        flex: 0 0 100%;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        scroll-snap-align: center;
        scroll-snap-stop: always;
        padding: 4px 0 8px;
      }

      .pass-card {
        width: 100%;
        max-width: 100%;
        margin: 0 auto;
        background: var(--surface);
        border: 1.5px solid var(--border);
        border-radius: 16px;
        padding: 12px;
        box-shadow: var(--shadow);
        display: flex;
        flex-direction: column;
        gap: 10px;
        overflow: hidden;
        transition: opacity 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .pass-card.is-relevant {
        border-color: var(--primary);
        box-shadow:
          0 0 0 2px rgba(59, 130, 246, 0.28),
          var(--shadow);
      }

      .pass-card.is-dimmed {
        opacity: 0.48;
      }

      .pass-card.is-dimmed:hover,
      .pass-card.is-dimmed:focus-within {
        opacity: 0.96;
      }

      .pass-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 6px;
        min-width: 0;
      }

      .pass-card-badges {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 5px;
        min-width: 0;
      }

      .meal-badge {
        display: inline-flex;
        align-items: center;
        padding: 3px 9px;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }

      .meal-b {
        background: rgba(245, 158, 11, 0.16);
        color: #fcd34d;
      }

      .meal-l {
        background: rgba(16, 185, 129, 0.16);
        color: #6ee7b7;
      }

      .meal-s {
        background: rgba(249, 115, 22, 0.18);
        color: #fdba74;
      }

      .meal-d {
        background: rgba(59, 130, 246, 0.2);
        color: #93c5fd;
      }

      .meal-u {
        background: rgba(148, 163, 184, 0.16);
        color: #cbd5e1;
      }

      .relevance-pill {
        display: inline-flex;
        align-items: center;
        padding: 2px 7px;
        border-radius: 999px;
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }

      .relevance-active {
        background: var(--primary);
        color: #ffffff;
      }

      .relevance-upcoming {
        background: var(--accent-soft);
        color: var(--accent-fg);
      }

      .delete-coupon-btn {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        border: 1px solid transparent;
        background: transparent;
        color: var(--text-muted);
        display: grid;
        place-items: center;
        flex-shrink: 0;
        cursor: pointer;
        transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
      }

      .delete-coupon-btn:hover,
      .delete-coupon-btn:active {
        color: var(--danger);
        border-color: rgba(239, 68, 68, 0.35);
        background: var(--danger-soft);
      }

      /* High-contrast pure-white QR frame for reliable optical scanning */
      .qr-frame,
      .transfer-qr-frame {
        width: 100%;
        min-width: 0;
        background: #ffffff;
        border-radius: 12px;
        padding: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }

      .qr-svg-host {
        display: block;
        width: 100%;
        max-width: min(100%, 48dvh);
        aspect-ratio: 1 / 1;
        margin: 0 auto;
      }

      .transfer-qr-frame .qr-svg-host {
        max-width: min(100%, 50dvh);
      }

      .qr-svg-host svg {
        width: 100%;
        height: 100%;
        max-width: 100%;
        max-height: 100%;
        display: block;
        shape-rendering: crispEdges;
      }

      .pass-card-footer {
        display: flex;
        flex-direction: column;
        gap: 5px;
        padding-top: 8px;
        border-top: 1px solid var(--border);
        min-width: 0;
      }

      .pass-meta-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        font-size: 0.78rem;
        min-width: 0;
      }

      .pass-meta-label {
        color: var(--text-muted);
        font-weight: 500;
        flex-shrink: 0;
      }

      .pass-meta-value {
        font-weight: 600;
        text-align: right;
        overflow-wrap: break-word;
      }

      .pass-meta-timing {
        font-size: 0.74rem;
        color: var(--text-muted);
      }

      .pass-meta-code {
        font-weight: 600;
        background: var(--surface-alt);
        border: 1px solid var(--border);
        padding: 1px 6px;
        border-radius: 5px;
        text-align: right;
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      /* Pagination Dots */
      .carousel-dots {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 14px;
      }

      .carousel-dots[hidden] {
        display: none;
      }

      .carousel-dot {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        border: none;
        padding: 0;
        background: var(--border);
        cursor: pointer;
        transition: width 0.2s ease, background 0.2s ease;
      }

      .carousel-dot.is-relevant-dot {
        background: rgba(59, 130, 246, 0.5);
      }

      .carousel-dot.is-active {
        width: 22px;
        background: var(--primary);
      }

      /* Empty State */
      .empty-state {
        background: var(--surface);
        border: 1px dashed var(--border);
        border-radius: 16px;
        padding: 28px 18px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
      }

      .empty-state[hidden] {
        display: none;
      }

      .empty-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: var(--surface-alt);
        color: var(--text-muted);
        display: grid;
        place-items: center;
        margin-bottom: 2px;
      }

      .empty-title {
        margin: 0;
        font-size: 0.96rem;
      }

      .empty-desc {
        margin: 0;
        font-size: 0.82rem;
        color: var(--text-muted);
        max-width: 260px;
      }

      .empty-jump-wrap {
        margin-top: 4px;
      }

      .empty-actions {
        display: flex;
        gap: 8px;
        margin-top: 4px;
      }

      /* Panels */
      .panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        min-width: 0;
      }

      .panel-danger {
        border-color: rgba(239, 68, 68, 0.28);
      }

      .panel-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
      }

      .panel-title {
        margin: 0;
        font-size: 0.94rem;
        font-weight: 700;
      }

      .panel-subtitle {
        margin: 2px 0 0;
        font-size: 0.78rem;
        color: var(--text-muted);
      }

      /* Buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 40px;
        padding: 0 14px;
        border-radius: 10px;
        border: 1px solid transparent;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
        transition: opacity 0.15s ease, transform 0.1s ease, background 0.15s ease, border-color 0.15s ease;
      }

      .btn:active:not(:disabled) {
        transform: scale(0.98);
      }

      .btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }

      .btn-sm {
        min-height: 34px;
        padding: 0 12px;
        font-size: 0.8rem;
        border-radius: 9px;
      }

      .btn-compact {
        min-height: 34px;
        padding: 0 10px;
        font-size: 0.75rem;
        border-radius: 9px;
      }

      .btn-full {
        width: 100%;
      }

      .btn-primary {
        background: var(--primary);
        color: var(--primary-fg);
      }

      .btn-primary:hover:not(:disabled) {
        background: var(--primary-hover);
      }

      .btn-secondary {
        background: var(--surface-alt);
        color: var(--text);
        border-color: var(--border);
      }

      .btn-secondary:hover:not(:disabled),
      .btn-ghost:hover:not(:disabled) {
        border-color: var(--primary);
      }

      .btn-ghost {
        background: transparent;
        color: var(--text-muted);
        border-color: var(--border);
      }

      .btn-danger {
        background: var(--danger);
        color: #ffffff;
      }

      .btn-danger:hover:not(:disabled) {
        opacity: 0.9;
      }

      .btn-danger-outline {
        background: var(--danger-soft);
        color: var(--danger-fg);
        border-color: rgba(239, 68, 68, 0.3);
      }

      .btn-danger-outline:hover:not(:disabled) {
        border-color: var(--danger);
      }

      .action-stack {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .action-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
      }

      .file-btn-label {
        user-select: none;
      }

      /* Scan & Manage Layouts */
      .scan-layout,
      .manage-columns {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .meal-selector-block {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .field-label {
        font-size: 0.76rem;
        font-weight: 600;
        color: var(--text-muted);
      }

      .field-hint {
        margin: 2px 0 0;
        font-size: 0.74rem;
        color: var(--text-muted);
        line-height: 1.4;
      }

      .segmented-control {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 3px;
        background: var(--surface-alt);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 3px;
      }

      .seg-btn {
        min-height: 32px;
        padding: 0 4px;
        border: none;
        border-radius: 7px;
        background: transparent;
        color: var(--text-muted);
        font-size: 0.72rem;
        font-weight: 600;
        cursor: pointer;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: background 0.15s ease, color 0.15s ease;
      }

      .seg-btn.is-selected {
        background: var(--primary);
        color: var(--primary-fg);
      }

      .camera-box {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 3;
        background: #000000;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--border);
      }

      .scanner-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .scanner-overlay {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        pointer-events: none;
      }

      .scanner-reticle {
        width: min(60%, 190px);
        aspect-ratio: 1 / 1;
        border: 2px solid var(--primary);
        border-radius: 14px;
        box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.45);
      }

      .camera-placeholder {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.85);
        color: var(--text-muted);
        display: grid;
        place-items: center;
        text-align: center;
        padding: 18px;
        font-size: 0.84rem;
      }

      .camera-placeholder[hidden] {
        display: none;
      }

      .feedback-banner {
        padding: 10px 12px;
        border-radius: 10px;
        font-size: 0.8rem;
        font-weight: 600;
      }

      .feedback-success {
        background: var(--accent-soft);
        color: var(--accent-fg);
      }

      .feedback-info {
        background: var(--surface-alt);
        color: var(--text);
        border: 1px solid var(--border);
      }

      .feedback-error {
        background: var(--danger-soft);
        color: var(--danger-fg);
      }

      .transfer-rx-card {
        background: var(--surface-alt);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 10px;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .transfer-rx-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
      }

      .muted-text {
        font-size: 0.76rem;
        color: var(--text-muted);
      }

      .chunk-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
      }

      .chunk-pill {
        min-width: 26px;
        height: 26px;
        padding: 0 7px;
        border-radius: 6px;
        font-size: 0.74rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text-muted);
      }

      .chunk-pill.is-done {
        background: var(--primary);
        border-color: var(--primary);
        color: #ffffff;
      }

      /* Stats Grid */
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
      }

      .stat-item {
        background: var(--surface-alt);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 9px 6px;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .stat-value {
        font-size: 0.96rem;
        font-weight: 800;
        letter-spacing: -0.02em;
      }

      .stat-label {
        font-size: 0.68rem;
        font-weight: 600;
        color: var(--text-muted);
      }

      /* PDF Dropzone & Progress */
      .file-dropzone {
        border: 1.5px dashed var(--border);
        border-radius: 12px;
        padding: 20px 14px;
        background: var(--surface-alt);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
        text-align: center;
        cursor: pointer;
        color: var(--text);
        transition: border-color 0.15s ease, background 0.15s ease;
      }

      .file-dropzone:hover,
      .file-dropzone.is-dragover {
        border-color: var(--primary);
        background: var(--accent-soft);
      }

      .dropzone-title {
        font-weight: 600;
        font-size: 0.84rem;
      }

      .dropzone-hint {
        font-size: 0.74rem;
        color: var(--text-muted);
      }

      .progress-wrap {
        display: flex;
        flex-direction: column;
        gap: 5px;
      }

      .progress-meta {
        display: flex;
        justify-content: space-between;
        font-size: 0.76rem;
        font-weight: 600;
        color: var(--text-muted);
      }

      .progress-track {
        height: 6px;
        border-radius: 999px;
        background: var(--surface-alt);
        border: 1px solid var(--border);
        overflow: hidden;
      }

      .progress-bar {
        height: 100%;
        background: var(--primary);
        transition: width 0.15s ease;
      }

      .pdf-result {
        background: var(--surface-alt);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 10px;
        font-size: 0.8rem;
      }

      .result-summary {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .result-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .text-success {
        color: var(--accent-fg);
      }

      .text-danger {
        color: var(--danger-fg);
      }

      .failure-details {
        margin-top: 8px;
        padding-top: 8px;
        border-top: 1px solid var(--border);
      }

      .failure-details summary {
        cursor: pointer;
        font-weight: 600;
        color: var(--danger-fg);
      }

      .failure-list {
        margin: 6px 0 0;
        padding-left: 16px;
        max-height: 160px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 3px;
        font-size: 0.76rem;
      }

      /* Mobile Bottom Nav */
      .bottom-nav {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: calc(var(--nav-height) + env(safe-area-inset-bottom));
        padding-bottom: env(safe-area-inset-bottom);
        background: rgba(10, 13, 20, 0.96);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-top: 1px solid var(--border);
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        z-index: 30;
      }

      .nav-item {
        border: none;
        background: transparent;
        color: var(--text-muted);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        font-size: 0.7rem;
        font-weight: 600;
        cursor: pointer;
        transition: color 0.15s ease;
      }

      .nav-item.is-active {
        color: var(--primary);
      }

      /* Modals */
      .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.8);
        display: grid;
        place-items: center;
        padding: 16px;
        z-index: 50;
      }

      .modal-backdrop[hidden] {
        display: none;
      }

      .modal-card {
        width: 100%;
        max-width: min(420px, calc(100vw - 24px));
        max-height: calc(100dvh - 24px);
        overflow-y: auto;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.75);
      }

      .modal-card-sm {
        max-width: min(310px, calc(100vw - 32px));
      }

      .modal-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 8px;
      }

      .modal-title {
        margin: 0;
        font-size: 0.98rem;
        font-weight: 700;
      }

      .modal-subtitle {
        margin: 2px 0 0;
        font-size: 0.76rem;
        color: var(--text-muted);
      }

      .transfer-controls {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 8px;
      }

      .chunk-counter {
        font-weight: 700;
        font-size: 0.84rem;
        padding: 0 4px;
        text-align: center;
      }

      .transfer-tip {
        margin: 0;
        font-size: 0.76rem;
        color: var(--text-muted);
        text-align: center;
      }

      .confirm-message {
        margin: 0;
        font-size: 0.84rem;
        color: var(--text-muted);
        line-height: 1.45;
      }

      .confirm-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-top: 2px;
      }

      /* Add as App Install Popup */
      .install-banner {
        position: fixed;
        left: 12px;
        right: 12px;
        bottom: calc(var(--nav-height) + env(safe-area-inset-bottom) + 10px);
        max-width: 440px;
        margin: 0 auto;
        background: var(--surface);
        border: 1px solid rgba(59, 130, 246, 0.45);
        border-radius: 14px;
        padding: 10px 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 14px 32px rgba(0, 0, 0, 0.72);
        z-index: 45;
      }

      .install-banner[hidden] {
        display: none;
      }

      .install-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        flex-shrink: 0;
        border: 1px solid var(--border);
      }

      .install-copy {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 1px;
      }

      .install-title {
        font-size: 0.84rem;
        font-weight: 700;
      }

      .install-desc {
        font-size: 0.73rem;
        color: var(--text-muted);
      }

      .install-close {
        width: 28px;
        height: 28px;
      }

      /* Toast */
      .toast {
        position: fixed;
        left: 50%;
        transform: translateX(-50%);
        bottom: calc(var(--nav-height) + env(safe-area-inset-bottom) + 12px);
        max-width: calc(100% - 32px);
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.6);
        z-index: 60;
        text-align: center;
      }

      .toast-info {
        background: #1e293b;
        color: #f8fafc;
      }

      .toast-success {
        background: var(--primary);
        color: #ffffff;
      }

      .toast-error {
        background: var(--danger);
        color: #ffffff;
      }

      /* =============================
         Desktop & Tablet Responsive UI
         ============================= */
      @media (min-width: 820px) {
        .app-shell {
          padding-bottom: 40px;
        }

        .header-inner {
          max-width: 980px;
          padding: 8px 24px;
          display: grid;
          grid-template-columns: 1fr auto 1fr;
          align-items: center;
          gap: 12px;
        }

        .header-actions {
          justify-self: end;
        }

        .desktop-nav {
          display: inline-flex;
          align-items: center;
          gap: 3px;
          background: var(--surface);
          border: 1px solid var(--border);
          border-radius: 10px;
          padding: 3px;
        }

        .desktop-nav .nav-item {
          flex-direction: row;
          gap: 6px;
          padding: 5px 14px;
          border-radius: 7px;
          font-size: 0.8rem;
          font-weight: 600;
          color: var(--text-muted);
          transition: background 0.15s ease, color 0.15s ease;
        }

        .desktop-nav .nav-item:hover:not(.is-active) {
          color: var(--text);
          background: var(--surface-alt);
        }

        .desktop-nav .nav-item.is-active {
          background: var(--primary);
          color: var(--primary-fg);
        }

        .bottom-nav {
          display: none;
        }

        .main-content {
          max-width: 980px;
          padding: 20px 24px 32px;
        }

        .view {
          gap: 16px;
        }

        .day-readable {
          font-size: 1.15rem;
        }

        .day-pass-count {
          font-size: 0.8rem;
        }

        /* Responsive Desktop Grid: 4 cards fit comfortably within 980px without overflow or overlap */
        .pass-carousel {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(200px, 224px));
          justify-content: center;
          gap: 14px;
          margin: 0;
          padding: 4px 0 8px;
          overflow: visible;
        }

        .pass-slide {
          flex: none;
          width: 100%;
          max-width: 100%;
          min-width: 0;
          scroll-snap-align: none;
          padding: 0;
        }

        .pass-card {
          max-width: 100%;
          height: 100%;
          padding: 12px;
        }

        .pass-card:hover {
          border-color: rgba(59, 130, 246, 0.55);
        }

        .qr-svg-host {
          max-width: 164px;
        }

        .transfer-qr-frame .qr-svg-host {
          max-width: 220px;
        }

        .modal-card {
          max-width: 340px;
        }

        .empty-state {
          max-width: 460px;
          width: 100%;
          margin: 20px auto;
          padding: 36px 24px;
        }

        /* Scan View: 2-Column Split */
        .scan-layout {
          display: grid;
          grid-template-columns: minmax(0, 1.25fr) minmax(290px, 0.85fr);
          gap: 16px;
          align-items: start;
        }

        .camera-box {
          aspect-ratio: 16 / 10;
        }

        /* Manage View: Bento Grid */
        .panel {
          padding: 18px;
          gap: 14px;
        }

        .stats-grid {
          gap: 12px;
        }

        .stat-item {
          padding: 12px 10px;
        }

        .stat-value {
          font-size: 1.25rem;
        }

        .stat-label {
          font-size: 0.72rem;
        }

        .manage-columns {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 16px;
          align-items: stretch;
        }

        .file-dropzone {
          padding: 26px 18px;
        }

        .danger-actions-grid {
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 10px;
        }

        .install-banner {
          left: auto;
          right: 20px;
          bottom: 20px;
          margin: 0;
          width: 360px;
        }

        /* Desktop Toast at bottom-right */
        .toast {
          left: auto;
          right: 20px;
          bottom: 20px;
          transform: none;
          max-width: 380px;
          text-align: left;
          padding: 10px 16px;
        }
      }
    </style>
  </body>
