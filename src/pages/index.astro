---
// 100% static, offline-first Mess Pass web application
import AppHeader from '../components/AppHeader.astro';
import BottomNav from '../components/BottomNav.astro';
import ConfirmModal from '../components/ConfirmModal.astro';
import InstallBanner from '../components/InstallBanner.astro';
import ManageView from '../components/ManageView.astro';
import PassesView from '../components/PassesView.astro';
import ScanView from '../components/ScanView.astro';
import TransferModal from '../components/TransferModal.astro';

import '../styles/tokens.css';
import '../styles/layout.css';
import '../styles/passes.css';
import '../styles/scan-manage.css';
import '../styles/overlays.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#000000" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta
      name="description"
      content="100% offline-first daily mess QR coupon wallet"
    />
    <link rel="manifest" href="./manifest.json" />
    <link rel="icon" type="image/svg+xml" href="./icon.svg" />
    <link rel="apple-touch-icon" href="./icon-192.png" />
    <title>Mess Pass</title>
  </head>
  <body>
    <div class="app-shell">
      <AppHeader />

      <main class="main-content">
        <PassesView />
        <ScanView />
        <ManageView />
      </main>

      <BottomNav />
    </div>

    <TransferModal />
    <ConfirmModal />
    <InstallBanner />

    <!-- Toast Container -->
    <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>

    <script>
      import '../client/app';
    </script>
  </body>
</html>
