<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.Dark">
        <item name="colorPrimary">#3B82F6</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="materialCalendarTheme">@style/MessPassCalendarTheme</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.Material3.Dark.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="colorPrimary">#3B82F6</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="materialCalendarTheme">@style/MessPassCalendarTheme</item>
    </style>

    <style name="MessPassCalendarTheme" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">#3B82F6</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">#0A0D14</item>
        <item name="colorSurfaceContainerHigh">#0A0D14</item>
        <item name="colorOnSurface">#F1F5F9</item>
        <item name="colorOnSurfaceVariant">#94A3B8</item>
        <item name="android:windowIsFloating">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
